{
  "name": "sixbell-fullstack-template",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap:openspec": "node scripts/bootstrap-openspec.mjs",
    "bootstrap:check": "node scripts/bootstrap-check.mjs",
    "bootstrap:verify": "node scripts/bootstrap-check.mjs --bootstrapped",
    "validate:format": "node scripts/validate-format.mjs",
    "validate:lint": "node scripts/validate-lint.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:smoke": "node scripts/test-smoke.mjs"
  }
}
