{
  "version": "1.0.0",
  "enabled": true,
  "name": "unit-test-on-save",
  "description": "Run unit validation automatically on save for the fullstack template.",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "apps/web/src/**/*.js",
      "apps/web/src/**/*.jsx",
      "apps/web/src/**/*.ts",
      "apps/web/src/**/*.tsx",
      "apps/api/src/**/*.js",
      "apps/api/src/**/*.ts",
      "packages/shared/src/**/*.js",
      "packages/shared/src/**/*.ts"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run test:unit --if-present"
  },
  "shortName": "unit-test-on-save"
}
