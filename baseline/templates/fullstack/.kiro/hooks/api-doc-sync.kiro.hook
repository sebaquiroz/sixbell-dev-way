{
  "enabled": true,
  "name": "api-doc-sync",
  "description": "Review whether documentation should be synchronized after changes in the fullstack template.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "apps/web/src/**/*.js",
      "apps/web/src/**/*.ts",
      "apps/web/src/**/*.tsx",
      "apps/api/src/**/*.js",
      "apps/api/src/**/*.ts",
      "packages/shared/src/**/*.js",
      "packages/shared/src/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file in the fullstack template repository has changed. Review whether documentation should also be updated according to The Sixbell-Dev Way. Check README, OpenAPI, CHANGELOG, ADRs, architecture docs, and usage examples. If straightforward low-risk updates are obvious, apply them. Otherwise, flag the needed updates clearly for human review."
  },
  "shortName": "api-doc-sync"
}
